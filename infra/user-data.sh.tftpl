#!/bin/bash
set -euo pipefail
${bootstrap}
usermod -aG docker ec2-user
mkdir -p /opt/monarchy
mkdir -p /opt/monarchy/secrets
mkdir -p /opt/monarchy/migrations
cat > /opt/monarchy/docker-compose.yml <<'COMPOSE'
services:
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - caddy-data:/data
      - caddy-config:/config
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    depends_on:
      - api
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    volumes:
      - redis-data:/data
  api:
    image: ${image}
    restart: unless-stopped
    env_file:
      - /etc/monarchy/app.env
    environment:
      REDIS_URL: http://redis:6379
    depends_on:
      - redis
volumes:
  redis-data:
  caddy-data:
  caddy-config:
COMPOSE
cat > /opt/monarchy/Caddyfile <<'CADDY'
api.monarchy1.com {
  header {
    -Server
    -Via
    Strict-Transport-Security "max-age=31536000"
  }
  reverse_proxy api:8080
}
CADDY
cat > /usr/local/bin/monarchy-update <<'UPDATE'
#!/bin/bash
set -euo pipefail
umask 077
cd /opt/monarchy
if [ -f /opt/monarchy/secrets/production.env.sops ]; then
  sops --decrypt --input-type dotenv --output-type dotenv \
    /opt/monarchy/secrets/production.env.sops > /etc/monarchy/app.env.tmp
  chown root:root /etc/monarchy/app.env.tmp
  chmod 600 /etc/monarchy/app.env.tmp
  mv /etc/monarchy/app.env.tmp /etc/monarchy/app.env
fi
aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin 930597685973.dkr.ecr.us-east-1.amazonaws.com
docker compose pull api
docker compose up -d --remove-orphans
docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
UPDATE
chmod 700 /usr/local/bin/monarchy-update
cat > /usr/local/bin/monarchy-migrate <<'MIGRATE'
#!/bin/bash
set -euo pipefail
set -a
source /etc/monarchy/app.env
set +a
: "$${JDBC_DATABASE_URL:?JDBC_DATABASE_URL is required for migrations}"
docker run --rm --network host \
  -e "FLYWAY_URL=$${FLYWAY_DATABASE_URL:-$JDBC_DATABASE_URL}" \
  -v /opt/monarchy/migrations:/flyway/sql:ro \
  -v /opt/monarchy/flyway.conf:/flyway/conf/flyway.conf:ro \
  flyway/flyway:10.20-alpine \
  -configFiles=/flyway/conf/flyway.conf migrate
MIGRATE
chmod 700 /usr/local/bin/monarchy-migrate
cat > /opt/monarchy/flyway.conf <<'FLYWAY'
flyway.locations=filesystem:/flyway/sql
flyway.baselineOnMigrate=true
flyway.baselineVersion=1
flyway.connectRetries=10
FLYWAY
# CI installs encrypted configuration and migrations before starting the app.
# Do not start an unconfigured stack on first boot.
